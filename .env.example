# Copy to .env for local Docker Compose, and create a separate secure .env on VPS.
# Never commit .env or put real secrets in GitHub.
DOCKERHUB_USERNAME=your-dockerhub-username
IMAGE_TAG=latest

# Required production secrets: replace all examples before running.
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost
ADMIN_EMAIL=admin@technova.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD

# MongoDB container credentials (not your TECHNOVA admin credentials)
MONGO_ROOT_USER=technova_root
MONGO_ROOT_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_PASSWORD
